@page "/inquiry/{DocumentId:int}"
@attribute [Authorize(Roles = "Manager,Operator")]
@using Zemanat.Core.Dates
@using Zemanat.Core.Documents
@using Zemanat.Core.Text
@using Zemanat.Data.Documents
@using Zemanat.Web.Auth
@inject AuthenticationStateProvider AuthState
@inject DocumentService DocService
@inject InquiryService Inquiries

<PageTitle>استعلام بانکی</PageTitle>

<h1 class="h4 mb-3">ثبت پاسخ استعلام بانکی</h1>

@if (!loaded)
{
    <p>در حال بارگذاری...</p>
}
else if (doc is null)
{
    <div class="alert alert-warning">سند پیدا نشد.</div>
}
else
{
    <div class="card card-body mb-3">
        <div><strong>@doc.PersonName</strong> (<bdi>@PersianText.ToPersianDigits(doc.PersonnelCode)</bdi>) - @doc.Type.Title()</div>
        <div class="text-muted small">شماره‌ی سند: <bdi>@PersianText.ToPersianDigits(doc.NumberText ?? "-")</bdi> - بانک: @doc.Beneficiary</div>
    </div>

    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger">@error</div> }

    @if (inquiry is not null)
    {
        <div class="alert alert-success">
            استعلام با شماره‌ی <bdi>@PersianText.ToPersianDigits(inquiry.NumberText)</bdi> ثبت شده است. برای هر سند فقط یک‌بار استعلام ثبت می‌شود.
        </div>
        <a class="btn btn-primary" href="/print/inquiry/@inquiry.Id"><i class="bi bi-printer ms-1"></i>چاپ استعلام</a>
    }
    else
    {
        <div class="card card-body">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">شماره‌ی نامه‌ی بانک</label><input class="form-control" dir="ltr" @bind="letterNumber" /></div>
                <div class="col-md-6"><label class="form-label">تاریخ نامه‌ی بانک (مثل ۱۴۰۵/۰۸/۲۳)</label><input class="form-control" dir="ltr" @bind="letterDate" /></div>
                <div class="col-md-6"><label class="form-label">وام‌گیرنده</label><input class="form-control" @bind="borrower" placeholder="اگر خالی باشد از اطلاعات سند پر می‌شود" /></div>
                <div class="col-md-6"><label class="form-label">نام پدر وام‌گیرنده</label><input class="form-control" @bind="borrowerFather" /></div>
            </div>
            <div class="mt-3"><button class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">ثبت و شماره‌گذاری</button></div>
        </div>
    }
}

@code {
    [Parameter] public int DocumentId { get; set; }

    private Document? doc;
    private BankInquiry? inquiry;
    private bool loaded, busy;
    private string? error;
    private string letterNumber = "", letterDate = "", borrower = "", borrowerFather = "";

    protected override async Task OnParametersSetAsync()
    {
        doc = await DocService.GetAsync(DocumentId);
        inquiry = doc is null ? null : await Inquiries.GetByDocumentAsync(doc.Id);
        loaded = true;
    }

    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var result = await Inquiries.CreateAsync(DocumentId, AccountEndpoints.GetUserId(user) ?? 0, letterNumber, letterDate, borrower, borrowerFather);
        if (result.Success) inquiry = result.Inquiry; else error = result.Error;
        busy = false;
    }
}

@page "/change-password"
@attribute [Authorize]
@using Zemanat.Data.Users
@using Zemanat.Web.Auth
@inject AuthenticationStateProvider AuthState
@inject UserAdminService Admin
@inject NavigationManager Navigation

<PageTitle>تغییر رمز عبور</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h4 mb-3">تغییر رمز عبور</h1>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        @if (done)
        {
            <div class="alert alert-success">رمز عبور با موفقیت تغییر کرد.</div>
        }

        <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="change-password" class="card card-body">
            <div class="mb-3">
                <label class="form-label">رمز فعلی</label>
                <InputText type="password" class="form-control" dir="ltr" @bind-Value="model.Current" />
            </div>
            <div class="mb-3">
                <label class="form-label">رمز جدید</label>
                <InputText type="password" class="form-control" dir="ltr" @bind-Value="model.New" />
            </div>
            <div class="mb-3">
                <label class="form-label">تکرار رمز جدید</label>
                <InputText type="password" class="form-control" dir="ltr" @bind-Value="model.Repeat" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@busy">ذخیره</button>
        </EditForm>
    </div>
</div>

@code {
    private readonly Model model = new();
    private string? error;
    private bool done, busy;

    private async Task SubmitAsync()
    {
        error = null;
        done = false;
        if (model.New != model.Repeat)
        {
            error = "رمز جدید و تکرار آن یکسان نیست.";
            return;
        }

        busy = true;
        var state = await AuthState.GetAuthenticationStateAsync();
        var id = AccountEndpoints.GetUserId(state.User);
        error = id is null ? "کاربر شناسایی نشد." : await Admin.ChangePasswordAsync(id.Value, model.Current, model.New);
        done = error is null;
        busy = false;
        model.Current = model.New = model.Repeat = string.Empty;
    }

    private sealed class Model
    {
        public string Current { get; set; } = string.Empty;
        public string New { get; set; } = string.Empty;
        public string Repeat { get; set; } = string.Empty;
    }
}

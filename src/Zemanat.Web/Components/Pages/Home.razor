@page "/"
@attribute [Authorize]
@using Zemanat.Core.Finance
@using Zemanat.Core.Security
@using Zemanat.Core.Settings
@using Zemanat.Core.Text
@using Zemanat.Data.Documents
@using Zemanat.Data.Settings
@using Zemanat.Web.Auth
@inject AuthenticationStateProvider AuthState
@inject DocumentService DocService
@inject SettingsStore SettingsStore

<PageTitle>سامانه‌ی صدور ضمانت‌نامه و گواهی</PageTitle>

<h1 class="h4 mb-4">خوش آمدید</h1>

@if (stats is not null && settings is not null)
{
    <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3"><div class="stat-box"><div class="text-muted small">در انتظار تأیید</div><strong class="fs-4"><bdi>@Fa(stats.Pending)</bdi></strong></div></div>
        <div class="col-6 col-md-3"><div class="stat-box"><div class="text-muted small">صادرشده</div><strong class="fs-4"><bdi>@Fa(stats.Issued)</bdi></strong></div></div>
        <div class="col-6 col-md-3"><div class="stat-box"><div class="text-muted small">تسویه‌شده</div><strong class="fs-4"><bdi>@Fa(stats.Settled)</bdi></strong></div></div>
        <div class="col-6 col-md-3"><div class="stat-box"><div class="text-muted small">مبلغ جاری (@MoneyFormatter.UnitTitle(settings.MoneyUnit))</div><strong><bdi>@MoneyFormatter.Format(stats.ActiveAmountRial, settings.MoneyUnit)</bdi></strong></div></div>
    </div>
}

<div class="row g-3">
    <div class="col-md-4 col-sm-6">
        <a class="card card-body tile text-center" href="/requests/new">
            <i class="bi bi-plus-circle mb-2"></i><strong>درخواست جدید</strong>
            <small class="text-muted">ثبت ضمانت‌نامه یا گواهی کسر از حقوق</small>
        </a>
    </div>
    <div class="col-md-4 col-sm-6">
        <a class="card card-body tile text-center" href="/documents">
            <i class="bi bi-files mb-2"></i><strong>اسناد</strong>
            <small class="text-muted">فهرست، وضعیت و چاپ</small>
        </a>
    </div>
    @if (isApprover)
    {
        <div class="col-md-4 col-sm-6">
            <a class="card card-body tile text-center" href="/approvals">
                <i class="bi bi-check2-square mb-2"></i><strong>تأیید درخواست‌ها</strong>
                <small class="text-muted">درخواست‌های مازاد منتظر تأیید</small>
            </a>
        </div>
    }
    @if (isStaff)
    {
        <div class="col-md-4 col-sm-6">
            <a class="card card-body tile text-center" href="/users">
                <i class="bi bi-people mb-2"></i><strong>کاربران و نقش‌ها</strong>
                <small class="text-muted">جست‌وجو، نقش، فعال‌سازی، بازنشانی رمز</small>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a class="card card-body tile text-center" href="/import">
                <i class="bi bi-file-earmark-excel mb-2"></i><strong>بارگذاری اکسل پرسنل</strong>
                <small class="text-muted">افزودن و به‌روزرسانی پرسنل</small>
            </a>
        </div>
    }
    @if (isManager)
    {
        <div class="col-md-4 col-sm-6">
            <a class="card card-body tile text-center" href="/settings">
                <i class="bi bi-gear mb-2"></i><strong>تنظیمات</strong>
                <small class="text-muted">سازمان، سقف، شماره‌گذاری، امضا و آدرس سایت</small>
            </a>
        </div>
    }
</div>

@code {
    private bool isManager, isStaff, isApprover;
    private DocumentStats? stats;
    private SystemSettings? settings;

    private static string Fa(int n) => PersianText.ToPersianDigits(n.ToString());

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        isManager = user.IsInRole(AppRoles.Manager);
        isStaff = isManager || user.IsInRole(AppRoles.Operator);
        isApprover = isManager || user.IsInRole(AppRoles.Approver);

        settings = await SettingsStore.LoadAsync();
        // Staff and approvers see the totals of everyone; an employee sees only their own documents.
        var all = isStaff || isApprover;
        stats = await DocService.GetStatsAsync(all ? null : AccountEndpoints.GetUserId(user));
    }
}
